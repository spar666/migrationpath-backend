# =============================================================================
# Backend environment
# =============================================================================
#
# Copy to .env and fill in. Ordered by what happens if you leave it blank:
#
#   REQUIRED    the server will not start
#   NEEDED      it starts, and something visible is broken
#   OPTIONAL    it starts and works; a convenience is missing
#
# Everything is validated at boot by src/config/config.validation.ts, which
# fails fast with a message naming the variable. A misspelled value is caught
# there rather than three layers down inside a checkout call.


# --- REQUIRED ----------------------------------------------------------------

# Signs and verifies login tokens. The ONE variable with no default and no
# graceful degradation — boot fails without it, deliberately, because a
# fallback secret is a fallback that reaches production.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Postgres. Either the URL on its own, or the five DB_* parts — not both.
# The URL wins if set.
DATABASE_URL=postgresql://postgres:password@localhost:5432/migration_db

# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=migration_db

# Managed Postgres (Supabase, Neon, RDS) generally needs this on. Local does not.
DB_SSL=false


# --- NEEDED: the app runs, the browser cannot reach it ------------------------

NODE_ENV=development
PORT=3000

# Comma-separated origins allowed to call this API. The frontend's dev server
# must be in here or every request fails CORS in the browser while working
# perfectly from curl — which is a confusing hour if you don't know to look.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8083

# Only relevant behind a reverse proxy or load balancer. Express reads the
# client IP differently depending on this, and the per-IP rate limit on
# POST /leads depends on that IP. Off when there IS a proxy means everyone
# shares one bucket; on when there ISN'T means clients can spoof their IP via
# X-Forwarded-For. "true" for a single hop (Vercel, Render, Heroku, one Nginx),
# a number for more than one. Set it explicitly — do not guess.
TRUST_PROXY=false


# --- NEEDED: taking money ----------------------------------------------------
#
# Register the webhook at:  POST /api/v1/webhooks/stripe
#
# Subscribe it to ALL FOUR of these:
#     checkout.session.completed
#     checkout.session.async_payment_succeeded
#     checkout.session.async_payment_failed
#     checkout.session.expired
#
# NOT payment_intent.succeeded. It fires on the same payments and looks like
# the right event, but it carries none of the session metadata that links a
# payment to a prospect and a booking, so nothing can be confirmed from it.
# Check the wiring any time with:  npm run stripe:doctor

# sk_test_ for a sandbox, sk_live_ for real money. A pk_ publishable key will
# not authenticate.
STRIPE_SECRET_KEY=

# The signing secret of THAT endpoint, from its page in the dashboard — or from
# `stripe listen` in dev, which issues a different one. Wrong value = every
# delivery is rejected 401 and Stripe eventually disables the endpoint.
STRIPE_WEBHOOK_SECRET=

# The consult fee, as a Price id. Not an amount, and not the prod_ Product id
# sitting next to it in the dashboard — both have been pasted here before, and
# both fail deep inside checkout where the visitor is told to "try again
# shortly", which cannot work. The amount lives in Stripe so the client can
# never name its own price.
STRIPE_CONSULT_PRICE_ID=

# Where Stripe returns the customer. These MUST match the frontend routes.
STRIPE_SUCCESS_URL=http://localhost:8080/consult/confirmed
STRIPE_CANCEL_URL=http://localhost:8080/consult/book


# --- NEEDED: booking a time --------------------------------------------------
#
# Register at:  POST /api/v1/webhooks/calendly   (invitee.created, invitee.canceled)
#
# ⚠️ This is CALENDLY'S OWN key, from Integrations -> Webhooks. It is NOT the
# Stripe whsec_. The two look alike and have been copy-pasted between these
# lines before; the result is that Calendly bookings fail signature checks
# silently, and a paid consultation ends up with no time attached to it.
#
# Webhook signing is plan-dependent. The endpoint is fail-closed: unset, it
# rejects everything rather than trusting unverified bookings. The browser also
# reports the booking directly, so the funnel still works without this — the
# times and join links just arrive less reliably.
CALENDLY_WEBHOOK_SIGNING_KEY=


# --- OPTIONAL: catching what the webhook missed -------------------------------
#
# Hourly sweep asking Stripe about checkout sessions still sitting unpaid after
# 26 hours, so a payment whose webhook never arrived is recovered rather than
# written off. Turn it on for exactly ONE instance — every instance would
# otherwise run the same sweep against a rate-limited API. Leave it off and
# drive it from POST /api/v1/payments/reconcile or an external cron instead.
#
# For a payment stuck right now, this is too slow. Use:
#   npm run stripe:doctor -- <event id> --replay
PAYMENT_RECONCILIATION_ENABLED=false


# --- OPTIONAL: alerts --------------------------------------------------------
#
# Leads and bookings are still captured and visible in the admin panel with all
# of this unset. What you lose is being told about them as they happen.
#
# NOTE: none of this emails the CUSTOMER. Nothing in this system does yet.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=leads@migrationpath.example
LEAD_NOTIFICATION_EMAIL=
SLACK_LEADS_WEBHOOK_URL=

# Builds the "view in admin" link inside those alerts.
ADMIN_BASE_URL=


# --- OPTIONAL: everything below has a working default -------------------------

JWT_EXPIRES_IN=7d

# Requests per window, per IP. The window is in milliseconds.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CMS content source.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
